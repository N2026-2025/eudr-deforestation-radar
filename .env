# EUDR Deforestation Radar - Environment Configuration Template
# Copy to .env and fill in your API keys

# Global Forest Watch API
GFW_API_KEY=your_gfw_api_key_here
GFW_DOMAIN_ALLOWLIST=localhost,yourdomain.com

# Microsoft Planetary Computer
# No auth needed for STAC search, but SAS token for data access
# Optional: subscription key for higher rate limits
PC_SDK_SUBSCRIPTION_KEY=your_planetary_computer_subscription_key

# UN Comtrade API
COMTRADE_API_KEY=your_comtrade_api_key

# NASA FIRMS Active Fire API
FIRMS_MAP_KEY=your_firms_map_key

# Database connections
DUCKDB_PATH=.data/silver/eudr.duckdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eudr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# EU Information System (for DDS submission)
EU_IS_BASE_URL=https://api.trades.ec.europa.eu
EU_IS_API_KEY=your_eu_is_api_key
EU_IS_OPERATOR_ID=your_operator_id

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json